{
  "name": "inveon-cloud-control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && rm -rf dist/migrations && cp -r src/migrations dist/migrations",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/migrate.js",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.mjs",
    "keys:status": "node dist/keys.js status",
    "keys:rotate": "node dist/keys.js rotate"
  },
  "dependencies": {
    "@aws-sdk/client-ec2": "3.1140.0",
    "@aws-sdk/client-ssm": "3.1140.0",
    "@aws-sdk/client-sts": "3.1140.0",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.33.0",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.4.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.10.1",
    "pg": "^8.12.0",
    "pino": "^9.0.0",
    "pino-http": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^6.4.24",
    "@types/pg": "^8.11.6",
    "drizzle-kit": "^0.24.2",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0"
  }
}
