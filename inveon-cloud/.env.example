# Copy to .env (git-ignored) and fill in. Generate secrets with:
#   openssl rand -base64 32
INVEON_POSTGRES_PASSWORD=
INVEON_JWT_SECRET=
# 32 random bytes, base64. Losing it makes every stored secret unreadable;
# keep a copy outside this server (password manager or AWS Secrets Manager).
INVEON_MASTER_KEY=
# Key rotation (see "Rotating the master key" in the README): extra keys as
# id:key pairs, and the id new values are encrypted with.
INVEON_MASTER_KEYS=
INVEON_MASTER_KEY_CURRENT=
# Who can see key status and start a rotation (comma-separated emails).
# Empty: the first account created on this installation.
INVEON_PLATFORM_ADMINS=
INVEON_PUBLIC_URL=https://cloud.inveontechnologies.in
INVEON_OPEN_SIGNUP=false
INVEON_GITHUB_TOKEN=
INVEON_ACME_EMAIL=
INVEON_SMTP_HOST=
INVEON_SMTP_PORT=587
INVEON_SMTP_SECURE=false
INVEON_SMTP_USER=
INVEON_SMTP_PASSWORD=
# Alert webhooks may only reach public https URLs. List internal hosts here
# (comma-separated) to allow them over a private address or plain http.
INVEON_ALERT_PRIVATE_HOSTS=
