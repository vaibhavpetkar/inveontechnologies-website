[Unit]
Description=Inveon Cloud agent
Documentation=https://github.com/vaibhavpetkar/inveontechnologies-website/tree/main/inveon-cloud
After=network-online.target docker.service nginx.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/node /opt/inveon-agent/dist/index.js run --config /etc/inveon-agent/config.json
Restart=always
RestartSec=5
# Root is needed for docker, nginx and certbot. The agent itself only runs
# the allow-listed programs (docker, nginx, systemctl, certbot, aws, tar, git).
User=root
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=full
# /root/.docker: docker build (buildx) keeps its state there.
ReadWritePaths=/etc/nginx/conf.d /etc/letsencrypt /var/lib/letsencrypt /var/log/letsencrypt /srv/inveon /var/www/inveon-acme /var/lib/inveon-agent /etc/inveon-agent -/root/.docker
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0027

[Install]
WantedBy=multi-user.target
