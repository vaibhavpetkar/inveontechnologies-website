# Copy this file to .env and fill in real values. Never commit .env to git.

# Where the Contact page form submits leads (JSON POST). Defaults to the CRM's
# public endpoint, which creates the lead and sends the emails:
# https://api.inveontechnologies.in/api/public/website-leads
# Only set this to test against another CRM. Never put API keys in a VITE_
# variable: it is bundled into the public JS.
# VITE_LEADS_API_URL=http://localhost:5000/api/public/website-leads

# Cashfree payment backend — creates orders server-side (never expose secret keys in frontend).
# Your backend should call Cashfree Create Order API and return { orderId, paymentSessionId }.
VITE_PAYMENT_API_URL=https://your-backend.example.com/api/payments/create-order

# Cashfree mode: "sandbox" for testing, "production" for live payments
VITE_CASHFREE_MODE=sandbox

# Candidate portal. The careers page lists its published openings and links Apply there.
VITE_PORTAL_URL=https://portal.inveontechnologies.in

# --- Server only: read by docker-compose.yml, never bundled into the site ---
# Inveon Cloud (https://cloud.inveontechnologies.in). Generate each secret on
# the server with `openssl rand -base64 32` (the Postgres password with
# `openssl rand -hex 24`) and keep a copy of INVEON_MASTER_KEY outside the
# server: losing it makes every stored secret unreadable. Optional settings
# (SMTP, GitHub token, platform admins) are listed in inveon-cloud/.env.example.
# INVEON_POSTGRES_PASSWORD=
# INVEON_JWT_SECRET=
# INVEON_MASTER_KEY=
