NODE_ENV=development
PORTAL_PORT=4000
PORTAL_CORS_ORIGIN=http://localhost:5173

# Required — server will not start without these.
PORTAL_DATABASE_URL=postgres://portal:CHANGE_ME@localhost:5432/portal
PORTAL_JWT_SECRET=CHANGE_ME_min_32_chars_random_string
PORTAL_REFRESH_SECRET=CHANGE_ME_a_different_min_32_chars_string
PORTAL_APP_URL=https://portal.inveontechnologies.in

# Optional — defaults shown
PORTAL_ACCESS_TOKEN_TTL_MIN=15
PORTAL_REFRESH_TOKEN_TTL_DAYS=30

# Outbound email (verification, password reset, assessment invites,
# certificates). Without PORTAL_SMTP_HOST, emails are only written to the
# backend log and password reset does NOT work. For the Mailcow server:
PORTAL_SMTP_HOST=mail.inveontechnologies.in
PORTAL_SMTP_PORT=587
# true = implicit TLS (port 465); false = STARTTLS (port 587)
PORTAL_SMTP_SECURE=false
PORTAL_SMTP_USER=no-reply@inveontechnologies.in
PORTAL_SMTP_PASSWORD=CHANGE_ME_mailbox_password
PORTAL_MAIL_FROM=Inveon Portal <no-reply@inveontechnologies.in>
# Where replies go. A real inbox someone reads (not no-reply) helps emails land in the inbox.
PORTAL_MAIL_REPLY_TO=Inveon HR <hr@inveontechnologies.in>
# Turn on only once email sending works.
PORTAL_REQUIRE_EMAIL_VERIFICATION=false

# Calendar video links (optional). Leave unset and the portal offers
# "Paste a link" only. Setup steps: docs/calendar-integrations.md
# PORTAL_GOOGLE_CLIENT_ID=
# PORTAL_GOOGLE_CLIENT_SECRET=
# PORTAL_GOOGLE_REFRESH_TOKEN=
# PORTAL_GOOGLE_CALENDAR_ID=primary
# PORTAL_ZOOM_ACCOUNT_ID=
# PORTAL_ZOOM_CLIENT_ID=
# PORTAL_ZOOM_CLIENT_SECRET=
# PORTAL_ZOOM_USER=me

# Uploaded files (resumes, documents, task and chat attachments). Docker
# Compose sets this to /app/uploads on the portal-uploads volume; locally
# they go to ./uploads.
# PORTAL_UPLOAD_DIR=uploads

# Registered office address, printed on the letterhead of appointment and
# offer letters. Optional; without it only the name and website are shown.
# PORTAL_COMPANY_ADDRESS=Office 12, Example Tower, Pune, Maharashtra 411001

# Automatic checking of internship coding exercises (JavaScript, Python, C,
# C++, C#, Java, SQL) through Judge0, which runs each program in a sandbox.
# Hosted: subscribe to Judge0 CE on RapidAPI and use its key. Self-hosted:
# your Judge0 URL and its X-Auth-Token. Leave unset and those exercises go to
# a mentor instead; HTML/CSS/React/config exercises are checked either way.
# PORTAL_JUDGE0_URL=https://judge0-ce.p.rapidapi.com
# PORTAL_JUDGE0_KEY=

# Encrypts passwords saved in Notes. Use a long random value (openssl rand -hex 32)
# and keep it: changing it makes saved passwords unreadable. Unset, the JWT
# secret is used instead, so rotating that would lose them too.
# PORTAL_VAULT_KEY=

# Program fees through Cashfree (same account as the Events site). Without
# the app id, "Pay now" is hidden; the free trial and "Mark paid" still work.
# In the Cashfree dashboard, add this webhook URL:
#   https://portal.inveontechnologies.in/api/v1/payments/cashfree/webhook
# CASHFREE_APP_ID=
# CASHFREE_SECRET_KEY=
# CASHFREE_ENV=sandbox   # "production" for live payments

# Tasks <-> GitHub issues. Create a fine-grained token on the Inveon org with
# Issues: read and write on the repos you use. Without it the GitHub buttons
# are hidden. For instant sync, add an org or repo webhook for "Issues" events:
#   URL:    https://portal.inveontechnologies.in/api/v1/github/webhook
#   Secret: the value of GITHUB_WEBHOOK_SECRET, content type application/json
# (Without the webhook, linked tasks still sync every 15 minutes.)
# GITHUB_TOKEN=
# GITHUB_WEBHOOK_SECRET=
# GITHUB_DEFAULT_REPO=inveon/internship-tasks

# Payroll: from this day of the month (India time) the portal drafts that
# month's payslips for HR to review and publish. Default 25.
# PAYROLL_DRAFT_DAY=25   # where issues from tasks outside a repo-linked project go

# Only used for `npm run db:seed`, never read by the running server.
# Pass at seed time, do not put long-term in this file:
# SEED_SUPER_ADMIN_EMAIL=admin@inveontechnologies.in
# SEED_SUPER_ADMIN_PASSWORD=choose-a-strong-password
# The same two variables are used by `npm run admin:reset-password` to set
# a new password for an existing account and clear any lockout.
