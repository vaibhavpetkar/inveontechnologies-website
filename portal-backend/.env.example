NODE_ENV=development
PORTAL_PORT=4000
PORTAL_CORS_ORIGIN=http://localhost:5173

# Required — server will not start without these.
PORTAL_DATABASE_URL=postgres://portal:CHANGE_ME@localhost:5432/portal
PORTAL_JWT_SECRET=CHANGE_ME_min_32_chars_random_string
PORTAL_REFRESH_SECRET=CHANGE_ME_a_different_min_32_chars_string
PORTAL_APP_URL=https://portal.inveontechnologies.in

# Optional — defaults shown
PORTAL_ACCESS_TOKEN_TTL_MIN=15
PORTAL_REFRESH_TOKEN_TTL_DAYS=30

# Only used for `npm run db:seed`, never read by the running server.
# Pass at seed time, do not put long-term in this file:
# SEED_SUPER_ADMIN_EMAIL=admin@inveontechnologies.in
# SEED_SUPER_ADMIN_PASSWORD=choose-a-strong-password
