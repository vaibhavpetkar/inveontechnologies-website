NODE_ENV=development
PORTAL_PORT=4000
PORTAL_CORS_ORIGIN=http://localhost:5173

# Required — server will not start without these.
PORTAL_DATABASE_URL=postgres://portal:CHANGE_ME@localhost:5432/portal
PORTAL_JWT_SECRET=CHANGE_ME_min_32_chars_random_string
PORTAL_REFRESH_SECRET=CHANGE_ME_a_different_min_32_chars_string
PORTAL_APP_URL=https://portal.inveontechnologies.in

# Optional — defaults shown
PORTAL_ACCESS_TOKEN_TTL_MIN=15
PORTAL_REFRESH_TOKEN_TTL_DAYS=30

# Outbound email (verification, password reset, assessment invites,
# certificates). Without PORTAL_SMTP_HOST, emails are only written to the
# backend log and password reset does NOT work. For the Mailcow server:
PORTAL_SMTP_HOST=mail.inveontechnologies.in
PORTAL_SMTP_PORT=587
# true = implicit TLS (port 465); false = STARTTLS (port 587)
PORTAL_SMTP_SECURE=false
PORTAL_SMTP_USER=no-reply@inveontechnologies.in
PORTAL_SMTP_PASSWORD=CHANGE_ME_mailbox_password
PORTAL_MAIL_FROM=Inveon Portal <no-reply@inveontechnologies.in>
# Turn on only once email sending works.
PORTAL_REQUIRE_EMAIL_VERIFICATION=false

# Only used for `npm run db:seed`, never read by the running server.
# Pass at seed time, do not put long-term in this file:
# SEED_SUPER_ADMIN_EMAIL=admin@inveontechnologies.in
# SEED_SUPER_ADMIN_PASSWORD=choose-a-strong-password
# The same two variables are used by `npm run admin:reset-password` to set
# a new password for an existing account and clear any lockout.
